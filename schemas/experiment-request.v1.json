{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-agent.local/schemas/experiment-request.v1.json",
  "title": "ExperimentRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "task", "evaluation_contract", "data_files", "output_dir", "random_seed"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "task": { "type": "object" },
    "evaluation_contract": { "type": "object" },
    "data_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "relative_path", "absolute_path", "media_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": { "type": "string" },
          "relative_path": { "type": "string" },
          "absolute_path": { "type": "string" },
          "media_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "output_dir": { "type": "string", "minLength": 1 },
    "random_seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "task_config": { "type": "object" }
  }
}
