{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-agent.local/schemas/experiment-result.v1.json",
  "title": "ExperimentResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "task_id", "plugin_id", "status", "method_results", "metrics", "warnings", "artifacts", "runtime"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "task_id": { "type": "string" },
    "plugin_id": { "type": "string" },
    "status": { "enum": ["success", "failed", "unsupported"] },
    "selected_method": { "type": "string" },
    "method_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "status", "metrics", "hard_checks_passed", "warnings"],
        "properties": {
          "method": { "type": "string" },
          "status": { "enum": ["success", "failed", "ineligible"] },
          "metrics": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
          "hard_checks_passed": { "type": "boolean" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "metrics": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relative_path", "media_type", "sha256", "size_bytes"],
        "properties": {
          "kind": { "enum": ["data", "figure", "table", "model", "log", "code", "other"] },
          "relative_path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "duration_ms", "python_version"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "python_version": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "message"],
      "properties": {
        "class": { "type": "string" },
        "message": { "type": "string" },
        "fingerprint": { "type": "string" }
      }
    }
  }
}
