{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-agent.local/schemas/task-graph.v1.json",
  "title": "TaskGraphV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_version", "problem_id", "nodes"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workflow_version": { "const": "0.1.0" },
    "problem_id": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "task_type", "objective", "requirement_ids", "depends_on", "input_artifact_ids", "evidence_level", "budget", "config"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "task_type": {
            "enum": [
              "statistical_analysis",
              "regression_prediction",
              "time_series_forecasting",
              "classification",
              "clustering",
              "evaluation_ranking",
              "optimization",
              "simulation",
              "custom_experiment"
            ]
          },
          "objective": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^req-[0-9]{3}$" }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^task-[0-9]{3}$" }
          },
          "input_artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_level": { "enum": ["standard", "experimental"] },
          "config": { "type": "object" },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts", "max_runtime_seconds", "max_tokens"],
            "properties": {
              "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
              "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 21600 },
              "max_tokens": { "type": "integer", "minimum": 256, "maximum": 200000 }
            }
          }
        }
      }
    }
  }
}
